---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FeatureCard from '~/components/FeatureCard.astro';
import FAQ from '~/components/FAQ.astro';
import { site, tools, type Tool } from '~/data/site';
import { getCollection } from 'astro:content';
import ToolShell from '~/components/ToolShell.astro';
import HomeSeo from '~/components/HomeSeo.astro';
import { getTool } from '~/data/site';
import { url, absUrl } from '~/lib/url';

const converter = getTool('dark-to-light')!;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const homeFaq = [
  {
    q: 'How do I convert black background notes to a white PDF?',
    a: 'Choose your PDF in the converter at the top of this page and click “Convert to white PDF”. Dark pages are turned into white pages with dark text, fitted to A4, and the new PDF downloads automatically. It takes a few seconds and works on phones too.',
  },
  {
    q: 'How do I print PW notes without wasting ink?',
    a: 'Convert the class-notes PDF to white here first, then print the converted file. Choose 2 slides per A4 sheet to also halve the paper. See the step-by-step PW guide for recommended settings.',
  },
  {
    q: 'Will the converted notes be A4 size?',
    a: 'Yes. By default every page is fitted and centred on A4 (portrait or landscape, whichever makes your pages biggest), so it prints at 100% without cropping. You can also keep the original page size.',
  },
  {
    q: 'Can I print 2 or 4 slides on one page?',
    a: 'Yes — pick 2, 4 or 6 slides per A4 sheet in the converter options. For white PDFs that do not need converting, use the Pages per Sheet tool.',
  },
  {
    q: 'Is Padhle Beta really free?',
    a: 'Yes — completely free, no signup, no watermarks, no page limits.',
  },
  {
    q: 'Do my files get uploaded to a server?',
    a: 'Never. Every tool runs in your browser. Your PDFs are processed on your own device — you can even turn off the internet after the page loads.',
  },
  {
    q: 'Will this work on my phone?',
    a: 'Yes. It works in Chrome on Android and Safari on iPhone. Very large PDFs (300+ pages) are faster on a laptop.',
  },
  {
    q: 'How is this different from other dark-to-light converters?',
    a: 'Auto mode only inverts dark pages (so white question pages stay white), a clean-up pass removes grey haze for a truly white background, output is A4 by default, and you get 13 other free PDF tools — with no sign-in and no uploads.',
  },
];

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: absUrl('/'),
  logo: absUrl('/icons/icon-512.png'),
  sameAs: [`https://github.com/${site.github.org}/${site.github.repo}`],
};

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: site.name,
  url: absUrl('/'),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (browser-based)',
  description: site.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: tools.map((t) => t.name),
};

---

<BaseLayout
  title="Convert Black Notes to White PDF – Print A4 Free | Padhle Beta"
  rawTitle
  description="Convert dark/black-background coaching notes (PW, Unacademy, Allen) to white, A4 printable PDF in seconds. Save up to 60% ink. Free, no signup, no upload."
  ogImage="/og/home.png"
  jsonLd={[orgJsonLd, webAppJsonLd]}
>
  {/* HERO — one job: drop a PDF, get a printable one */}
  <section class="hero" id="convert">
    <div class="container hero__inner">
      <p class="pill">
        <span class="pill__dot" aria-hidden="true"></span>
        100% free · No signup · Works on your phone
      </p>
      <h1 class="hero__title">
        Black notes to white PDF.
        <span class="hero__accent">A4 &amp; ready to print.</span>
      </h1>
      <p class="hero__sub">
        Drop your PW, Unacademy or ALLEN notes. Every black page turns white, fits A4, and downloads in seconds.
      </p>

      <div class="hero__tool">
        <ToolShell tool={converter} instant dropTitle="Drop your dark notes PDF here" runLabel="Convert again" />
      </div>

      <ul class="assure" role="list">
        <li><span aria-hidden="true">🔒</span> Never uploaded — stays on your device</li>
        <li><span aria-hidden="true">🖨️</span> A4, prints like normal notes</li>
        <li><span aria-hidden="true">⚡</span> Ready in seconds</li>
      </ul>
    </div>
  </section>

  {/* BEFORE / AFTER */}
  <section class="section compare-section">
    <div class="container">
      <header class="center-head">
        <span class="eyebrow">See the difference</span>
        <h2>Same notes. A fraction of the ink.</h2>
        <p>Drag the slider. This is exactly what the converter does to your pages.</p>
      </header>

      <div class="ba" data-ba style="--pos: 50%">
        <div class="ba__layer ba__layer--after" aria-hidden="true">
          <div class="board">
            <div class="board__title">Rotational Motion</div>
            <div class="board__row"><span class="y">τ = I α</span><span class="p">L = I ω</span></div>
            <div class="board__line">Moment of inertia (ring): <span class="y">I = MR²</span></div>
            <div class="board__line">Disc: <span class="y">I = ½ MR²</span> &nbsp; Rod (centre): <span class="y">I = ML²/12</span></div>
            <svg class="board__fig" viewBox="0 0 120 80" aria-hidden="true"><circle cx="60" cy="40" r="28" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M60 40 L88 40" stroke="#ffd43b" stroke-width="2.5"/><path d="M30 18 A36 36 0 0 1 90 18" fill="none" stroke="#ff8cc6" stroke-width="2.5"/><path d="M90 18 l-8 -1 m8 1 l-3 7" stroke="#ff8cc6" stroke-width="2.5" fill="none"/></svg>
            <div class="board__note p">★ If τ<sub>ext</sub> = 0 → L is conserved</div>
          </div>
        </div>
        <div class="ba__layer ba__layer--before" aria-hidden="true">
          <div class="board">
            <div class="board__title">Rotational Motion</div>
            <div class="board__row"><span class="y">τ = I α</span><span class="p">L = I ω</span></div>
            <div class="board__line">Moment of inertia (ring): <span class="y">I = MR²</span></div>
            <div class="board__line">Disc: <span class="y">I = ½ MR²</span> &nbsp; Rod (centre): <span class="y">I = ML²/12</span></div>
            <svg class="board__fig" viewBox="0 0 120 80" aria-hidden="true"><circle cx="60" cy="40" r="28" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M60 40 L88 40" stroke="#ffd43b" stroke-width="2.5"/><path d="M30 18 A36 36 0 0 1 90 18" fill="none" stroke="#ff8cc6" stroke-width="2.5"/><path d="M90 18 l-8 -1 m8 1 l-3 7" stroke="#ff8cc6" stroke-width="2.5" fill="none"/></svg>
            <div class="board__note p">★ If τ<sub>ext</sub> = 0 → L is conserved</div>
          </div>
        </div>
        <span class="ba__tag ba__tag--l">Before · coaching PDF</span>
        <span class="ba__tag ba__tag--r">After · print-ready</span>
        <div class="ba__handle" aria-hidden="true"><span>⟷</span></div>
        <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after" data-ba-range />
      </div>
    </div>
  </section>

  {/* 3 STEPS */}
  <section class="section section--soft">
    <div class="container">
      <header class="center-head">
        <span class="eyebrow">How it works</span>
        <h2>Three steps. No learning curve.</h2>
      </header>
      <ol class="steps3" role="list">
        <li>
          <span class="steps3__n">1</span>
          <h3>Download your notes</h3>
          <p>Save the notes PDF from your coaching app or website to your phone or laptop.</p>
        </li>
        <li>
          <span class="steps3__n">2</span>
          <h3>Drop it above</h3>
          <p>Black pages become white with dark writing. White pages stay as they are.</p>
        </li>
        <li>
          <span class="steps3__n">3</span>
          <h3>Print</h3>
          <p>Print at home or send to the Xerox shop. Ask for A4 at 100% scale.</p>
        </li>
      </ol>
      <p class="center-cta"><a href="#convert" class="btn btn--primary btn--lg">Convert my notes — it’s free</a></p>
    </div>
  </section>

  <HomeSeo />

  {/* MORE TOOLS */}
  <section class="section">
    <div class="container">
      <header class="center-head">
        <span class="eyebrow">Also free</span>
        <h2>Other tools for your notes</h2>
      </header>
      <ul class="toolchips" role="list">
        {tools.filter((t) => t.slug !== 'dark-to-light').map((t) => (
          <li>
            <a href={url(`/tools/${t.slug}/`)}>
              <strong>{t.name}</strong>
              <span>{t.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FAQ items={homeFaq} id="home-faq" />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((ba) => {
    const range = ba.querySelector<HTMLInputElement>('[data-ba-range]')!;
    const set = () => ba.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    // Gentle hint animation the first time it scrolls into view.
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const frames = [50, 70, 30, 50];
      let i = 0;
      const step = () => { if (i >= frames.length) return; range.value = String(frames[i++]); set(); setTimeout(step, 450); };
      setTimeout(step, 300);
    }, { threshold: 0.6 });
    io.observe(ba);
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(2.25rem, 6vw, 4.5rem) clamp(2.5rem, 6vw, 4.5rem);
    background:
      radial-gradient(50% 60% at 15% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(45% 55% at 90% 10%, color-mix(in srgb, #3b82f6 12%, transparent), transparent 70%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .hero__inner { max-width: 780px; text-align: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 0.5rem;
    margin: 0 0 var(--space-5); padding: 0.4rem 0.9rem;
    border: 1px solid var(--border); border-radius: 999px; background: var(--bg-elev);
    font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 700; color: var(--fg-muted);
    box-shadow: var(--shadow-xs);
  }
  .pill__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green-600); box-shadow: 0 0 0 3px color-mix(in srgb, var(--green-600) 22%, transparent); }
  .hero__title {
    font-size: clamp(2.2rem, 5.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 0;
    text-wrap: balance;
  }
  .hero__accent {
    display: block;
    color: var(--accent);
  }
  .hero__sub {
    font-family: var(--font-ui);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--fg-muted);
    max-width: 36rem;
    margin: var(--space-5) auto 0;
    text-wrap: balance;
  }
  .hero__tool {
    margin-top: var(--space-7);
    text-align: left;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-xl);
    padding: 6px;
  }
  .hero__tool :global(.tool-shell) { border: 0; background: transparent; }
  .assure {
    list-style: none; padding: 0; margin: var(--space-5) 0 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-5);
    font-family: var(--font-ui); font-size: 0.875rem; font-weight: 600; color: var(--fg-muted);
  }

  /* ---------- Shared ---------- */
  .center-head { text-align: center; max-width: 640px; margin: 0 auto var(--space-7); }
  .center-head h2 { margin-top: var(--space-2); }
  .center-head p { font-family: var(--font-ui); color: var(--fg-muted); margin-top: var(--space-3); }
  .center-cta { text-align: center; margin-top: var(--space-7); }

  /* ---------- Before / after ---------- */
  .ba {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--border);
    user-select: none;
  }
  .ba__layer { position: absolute; inset: 0; }
  .ba__layer--before { background: #0b0d12; color: #f5f5f4; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  /* The "after" layer is literally the dark board inverted — same as the tool. */
  .ba__layer--after { background: #000; color: #f5f5f4; filter: invert(1); }
  .board {
    height: 100%;
    padding: 5% 6%;
    font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(1rem, 2.9vw, 1.85rem);
    line-height: 1.25;
    display: grid;
    align-content: start;
    gap: 2.2%;
    position: relative;
  }
  .board__title { font-size: 1.5em; font-weight: 700; text-decoration: underline; text-decoration-color: #ffd43b; text-underline-offset: 0.18em; }
  .board__row { display: flex; gap: 12%; font-size: 1.25em; }
  .board .y { color: #ffd43b; }
  .board .p { color: #ff8cc6; }
  .board__fig { position: absolute; right: 6%; top: 12%; width: 22%; color: #f5f5f4; }
  .board__note { margin-top: 2%; }
  .ba__tag {
    position: absolute; top: 12px;
    padding: 0.3rem 0.7rem; border-radius: 999px;
    font-family: var(--font-ui); font-size: 0.75rem; font-weight: 700;
    background: rgba(0, 0, 0, 0.55); color: #fff; backdrop-filter: blur(6px);
    pointer-events: none;
  }
  .ba__tag--l { left: 12px; }
  .ba__tag--r { right: 12px; background: var(--accent); }
  .ba__handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos);
    width: 3px; margin-left: -1.5px; background: #fff;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.15);
    pointer-events: none;
  }
  .ba__handle span {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 42px; height: 42px; border-radius: 50%;
    display: grid; place-items: center;
    background: #fff; color: #111; font-size: 1.1rem; font-weight: 800;
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
  }
  .ba__range {
    position: absolute; inset: 0; width: 100%; height: 100%;
    margin: 0; opacity: 0; cursor: ew-resize;
  }
  .ba__range:focus-visible + * { outline: none; }
  .ba:focus-within { outline: 3px solid var(--accent); outline-offset: 3px; }

  /* ---------- Steps ---------- */
  .steps3 {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5);
  }
  @media (max-width: 760px) { .steps3 { grid-template-columns: 1fr; } }
  .steps3 li {
    background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: var(--space-6); box-shadow: var(--shadow-sm);
  }
  .steps3__n {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px;
    background: var(--accent); color: #fff; font-family: var(--font-ui); font-weight: 800; font-size: 1.125rem;
    margin-bottom: var(--space-4);
  }
  .steps3 h3 { font-size: 1.1875rem; margin-bottom: var(--space-2); }
  .steps3 p { font-family: var(--font-ui); font-size: 0.9375rem; line-height: 1.6; color: var(--fg-muted); margin: 0; }

  /* ---------- Tools ---------- */
  .toolchips {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: var(--space-3);
  }
  .toolchips a {
    display: block; height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-elev); color: inherit;
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .toolchips a:hover { border-color: var(--accent); text-decoration: none; transform: translateY(-2px); }
  .toolchips strong { display: block; font-family: var(--font-ui); font-size: 0.9875rem; color: var(--fg); }
  .toolchips span { display: block; font-family: var(--font-ui); font-size: 0.8125rem; color: var(--fg-muted); margin-top: 0.25rem; line-height: 1.45; }
</style>
