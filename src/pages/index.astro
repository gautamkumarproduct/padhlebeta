---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FeatureCard from '~/components/FeatureCard.astro';
import FAQ from '~/components/FAQ.astro';
import ToolIcon from '~/components/ToolIcon.astro';
import PrivacyDiagram from '~/components/PrivacyDiagram.astro';
import { site, tools, type Tool } from '~/data/site';
import { getCollection } from 'astro:content';
import ToolShell from '~/components/ToolShell.astro';
import HomeSeo from '~/components/HomeSeo.astro';
import { getTool } from '~/data/site';
import { url, absUrl } from '~/lib/url';

const converter = getTool('dark-to-light')!;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const homeFaq = [
  {
    q: 'How do I convert black background notes to a white PDF?',
    a: 'Choose your PDF in the converter at the top of this page and click “Convert to white PDF”. Dark pages are turned into white pages with dark text, fitted to A4, and the new PDF downloads automatically. It takes a few seconds and works on phones too.',
  },
  {
    q: 'How do I print PW notes without wasting ink?',
    a: 'Convert the class-notes PDF to white here first, then print the converted file. Choose 2 slides per A4 sheet to also halve the paper. See the step-by-step PW guide for recommended settings.',
  },
  {
    q: 'Will the converted notes be A4 size?',
    a: 'Yes. By default every page is fitted and centred on A4 (portrait or landscape, whichever makes your pages biggest), so it prints at 100% without cropping. You can also keep the original page size.',
  },
  {
    q: 'Can I print 2 or 4 slides on one page?',
    a: 'Yes — pick 2, 4 or 6 slides per A4 sheet in the converter options. For white PDFs that do not need converting, use the Pages per Sheet tool.',
  },
  {
    q: 'Is Padhle Beta really free?',
    a: 'Yes — completely free, no signup, no watermarks, no page limits.',
  },
  {
    q: 'Do my files get uploaded to a server?',
    a: 'Never. Every tool runs in your browser. Your PDFs are processed on your own device — you can even turn off the internet after the page loads.',
  },
  {
    q: 'Will this work on my phone?',
    a: 'Yes. It works in Chrome on Android and Safari on iPhone. Very large PDFs (300+ pages) are faster on a laptop.',
  },
  {
    q: 'How is this different from other dark-to-light converters?',
    a: 'Auto mode only inverts dark pages (so white question pages stay white), a clean-up pass removes grey haze for a truly white background, output is A4 by default, and you get 13 other free PDF tools — with no sign-in and no uploads.',
  },
];

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: absUrl('/'),
  logo: absUrl('/icons/icon-512.png'),
  sameAs: [`https://github.com/${site.github.org}/${site.github.repo}`],
};

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: site.name,
  url: absUrl('/'),
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (browser-based)',
  description: site.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: tools.map((t) => t.name),
};

---

<BaseLayout
  title="Convert Black Notes to White PDF – Print A4 Free | Padhle Beta"
  rawTitle
  description="Convert dark/black-background coaching notes (PW, Unacademy, Allen) to white, A4 printable PDF in seconds. Save up to 60% ink. Free, no signup, no upload."
  ogImage="/og/home.png"
  jsonLd={[orgJsonLd, webAppJsonLd]}
>
  {/* HERO */}
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__badge fade-up">
          <span class="hero__badge-dot" aria-hidden="true"></span>
          Free for every student · No signup
        </p>
        <h1 class="hero__title fade-up fade-up--1">
          Black notes to white PDF,
          <span class="hero__accent">A4 &amp; ready to print.</span>
        </h1>
        <p class="hero__lede fade-up fade-up--2">
          Choose the dark-background PDF from PW, Unacademy, ALLEN or any coaching app.
          In a few seconds you get clean black-on-white A4 pages — ready for your printer or the Xerox shop.
        </p>

        <figure class="compare fade-up fade-up--3" aria-label="Example: a dark lecture slide converted to a white A4 page">
          <div class="compare__item">
            <div class="compare__dark" aria-hidden="true">
              <span class="compare__h"></span>
              <span class="compare__l compare__l--y" style="width:78%"></span>
              <span class="compare__l" style="width:64%"></span>
              <span class="compare__l compare__l--p" style="width:70%"></span>
              <span class="compare__l" style="width:52%"></span>
            </div>
            <figcaption>Your coaching PDF</figcaption>
          </div>
          <svg class="compare__arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          <div class="compare__item">
            <div class="compare__a4" aria-hidden="true">
              <div class="compare__slide">
                <span class="compare__h"></span>
                <span class="compare__l compare__l--y" style="width:78%"></span>
                <span class="compare__l" style="width:64%"></span>
                <span class="compare__l compare__l--p" style="width:70%"></span>
                <span class="compare__l" style="width:52%"></span>
              </div>
              <div class="compare__slide">
                <span class="compare__h"></span>
                <span class="compare__l" style="width:70%"></span>
                <span class="compare__l compare__l--y" style="width:58%"></span>
                <span class="compare__l" style="width:74%"></span>
              </div>
            </div>
            <figcaption>White A4, 2 slides per page</figcaption>
          </div>
        </figure>

        <ul class="trust fade-up fade-up--4" role="list">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <div><strong>Stays on your device</strong><span>Converted in your browser. Nothing is uploaded.</span></div>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg>
            <div><strong>Prints like normal notes</strong><span>Pure white background, sharp text, A4 margins.</span></div>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <div><strong>No catch</strong><span>No login, no watermark, no page limit.</span></div>
          </li>
        </ul>
      </div>

      <div class="hero__tool fade-up fade-up--2" id="convert">
        <div class="converter">
          <div class="converter__head">
            <h2 class="converter__title">Convert your notes</h2>
            <ol class="converter__steps" role="list">
              <li><span>1</span>Choose PDF</li>
              <li><span>2</span>Convert</li>
              <li><span>3</span>Print</li>
            </ol>
          </div>
          <ToolShell tool={converter} runLabel="Convert to white PDF" />
        </div>
        <p class="hero__works">Works with notes from PW · Unacademy · ALLEN · Vedantu · Aakash · any dark PDF</p>
      </div>
    </div>
  </section>

  <HomeSeo />

  {/* TOOL CARDS */}
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">More free PDF tools</span>
        <h2>Everything else you need<br/>to print coaching notes.</h2>
        <p class="section-head__lede">
          {tools.length} focused tools — pages per sheet, merge, split, organise, crop, compress and more.
          All free, all in your browser.
        </p>
      </header>
      <div class="grid grid--3">
        {tools.map((t: Tool, i: number) => (
          <div class={`reveal reveal--${(i % 5) + 1}`}>
            <FeatureCard
              href={`${site.basePath}/tools/${t.slug}/`}
              title={t.name}
              description={t.description}
              iconType={t.slug}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* HOW IT WORKS */}
  <section class="section section--soft">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>From dark slides to printed notes<br/>in under a minute.</h2>
      </header>
      <ol class="steps reveal" role="list">
        <li class="step">
          <span class="step__num">01</span>
          <h3>Choose your PDF</h3>
          <p>Download the notes PDF from your coaching app, then choose it above. Phones and laptops both work.</p>
        </li>
        <li class="step">
          <span class="step__num">02</span>
          <h3>We make it print-ready</h3>
          <p>Dark pages become white with dark text. Pages that are already white are left alone. Everything is fitted to A4.</p>
        </li>
        <li class="step">
          <span class="step__num">03</span>
          <h3>Print or share</h3>
          <p>The new PDF downloads straight away. Print it at home, or send it to the Xerox shop at 100% scale.</p>
        </li>
      </ol>
    </div>
  </section>

  {/* PRIVACY PROMISE */}
  <section class="section privacy-section">
    <div class="container privacy">
      <div class="reveal">
        <span class="eyebrow">Privacy first</span>
        <h2>Your notes never leave your browser.</h2>
        <p class="privacy__lede">
          Padhle Beta is built around a single privacy promise: every PDF you process stays on your device.
          Open your browser's DevTools, switch to the Network tab, and run any tool. You will see zero uploads.
        </p>
        <ul role="list" class="privacy__list">
          <li><strong>No accounts.</strong> No email, no Google sign-in, no phone number.</li>
          <li><strong>No analytics on your files.</strong> We never see what you upload — we cannot, by design.</li>
          <li><strong>No ads.</strong> No third-party trackers, no retargeting pixels, no nonsense.</li>
          <li><strong>Open source.</strong> Every line of code lives on GitHub. Audit it yourself.</li>
        </ul>
        <a href={`${site.basePath}/privacy/`} class="btn btn--ghost">Read the privacy policy →</a>
      </div>
      <div class="privacy__visual reveal">
        <PrivacyDiagram />
      </div>
    </div>
  </section>

  {/* WHY PADHLE BETA */}
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">Why Padhle Beta</span>
        <h2>Built for Indian students,<br/>not generic PDF users.</h2>
      </header>

      <div class="comparison reveal">
        <div class="comparison__col">
          <h3>Other PDF tools</h3>
          <ul role="list">
            <li>Upload your file to a server</li>
            <li>Force a signup before download</li>
            <li>Stamp your file with a watermark</li>
            <li>Slow, ad-cluttered interface</li>
            <li>Made for office workers in 2014</li>
          </ul>
        </div>
        <div class="comparison__col comparison__col--us">
          <h3>Padhle Beta</h3>
          <ul role="list">
            <li>Everything runs in your browser. Zero uploads.</li>
            <li>No signup, ever. Open and use.</li>
            <li>No watermark, no branding, no nonsense</li>
            <li>Fast, mobile-first, clean UI</li>
            <li>Made for NEET/JEE students printing coaching notes</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* BLOG TEASER */}
  <section class="section section--soft">
    <div class="container">
      <header class="section-head section-head--row reveal">
        <div>
          <span class="eyebrow">From the blog</span>
          <h2>Tips, guides, and study strategies.</h2>
        </div>
        <a href={`${site.basePath}/blog/`} class="btn btn--ghost">All posts →</a>
      </header>
      <div class="grid grid--3">
        {posts.map((post, i) => (
          <a class={`card blog-card reveal reveal--${i + 1}`} href={`${site.basePath}/blog/${post.id}/`}>
            <span class="tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="blog-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <span>· 5 min read</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* HOME FAQ */}
  <FAQ items={homeFaq} id="home-faq" />

  {/* NEWSLETTER + DONATE */}
  <section class="section cta-section">
    <div class="atmos-blob atmos-blob--1" aria-hidden="true"></div>
    <div class="atmos-blob atmos-blob--2" aria-hidden="true"></div>
    <div class="container cta">
      <div class="reveal">
        <h2>Like the tools?<br/>Help us keep them free.</h2>
        <p>
          Padhle Beta is built and hosted on a student budget. If these tools saved you ink or money,
          consider chipping in for server time or just sharing the site with a friend.
        </p>
      </div>
      <div class="cta__actions reveal">
        <a href={`${site.basePath}/contact/`} class="btn btn--primary btn--lg">Share feedback</a>
        <a href={`https://github.com/${site.github.org}/${site.github.repo}`} class="btn btn--ghost btn--lg" rel="noopener">★ Star on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Scroll-triggered reveal — uses IntersectionObserver, runs once.
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    reveals.forEach((el) => io.observe(el));
  } else {
    // Fallback for ancient browsers
    reveals.forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
    background:
      radial-gradient(60% 50% at 85% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .hero__grid > * { min-width: 0; }
  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; gap: var(--space-5); }
    /* Phones/tablets: converter right under the headline. */
    .hero__copy { display: contents; }
    .hero__copy > * { order: 1; }
    .hero__tool { order: 2; }
    .hero__copy > .hero__lede, .hero__copy > .compare, .hero__copy > .trust { order: 3; }
  }

  .hero__badge {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--space-5);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg-muted);
  }
  .hero__badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green-600); box-shadow: 0 0 0 3px color-mix(in srgb, var(--green-600) 20%, transparent); }

  .hero__title {
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }
  .hero__accent { display: block; color: var(--accent); }

  .hero__lede {
    font-family: var(--font-ui);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 34rem;
    margin: var(--space-5) 0 0;
  }

  /* Before → after preview */
  .compare {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: var(--space-7) 0 0;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    max-width: 34rem;
  }
  .compare__item { flex: 1; display: grid; gap: 0.6rem; justify-items: center; margin: 0; }
  .compare__item figcaption { font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 600; color: var(--fg-muted); text-align: center; }
  .compare__arrow { color: var(--accent); flex-shrink: 0; }
  .compare__dark {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0d0f14;
    border-radius: 6px;
    padding: 10% 9%;
    display: grid;
    align-content: start;
    gap: 7%;
    box-shadow: var(--shadow-sm);
  }
  .compare__a4 {
    height: 100%;
    width: 62%;
    aspect-ratio: 210 / 297;
    background: #fff;
    border-radius: 3px;
    padding: 7% 8%;
    display: grid;
    gap: 6%;
    align-content: start;
    box-shadow: var(--shadow);
    border: 1px solid #e7e5e0;
  }
  .compare__slide {
    aspect-ratio: 16 / 9;
    border: 1px solid #d9d7d2;
    padding: 8% 9%;
    display: grid;
    align-content: start;
    gap: 9%;
  }
  .compare__h, .compare__l { display: block; height: 5px; border-radius: 3px; }
  .compare__h { width: 45%; height: 7px; background: #f5f5f4; }
  .compare__l { background: #cbd5e1; }
  .compare__l--y { background: #fcd34d; }
  .compare__l--p { background: #f9a8d4; }
  .compare__slide .compare__h { background: #111; height: 4px; }
  .compare__slide .compare__l { background: #334155; height: 3px; }
  .compare__slide .compare__l--y { background: #3b5bdb; }
  .compare__slide .compare__l--p { background: #0f8a4a; }

  /* Trust points */
  .trust { list-style: none; padding: 0; margin: var(--space-7) 0 0; display: grid; gap: var(--space-4); max-width: 34rem; }
  .trust li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .trust svg { color: var(--accent); margin-top: 2px; }
  .trust strong { display: block; font-family: var(--font-ui); font-size: 0.9375rem; color: var(--fg); }
  .trust span { display: block; font-family: var(--font-ui); font-size: 0.875rem; color: var(--fg-muted); margin-top: 1px; }

  /* Converter card */
  .converter {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-lg) + 4px);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .converter__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border);
  }
  .converter__title { font-size: 1.0625rem; margin: 0; letter-spacing: -0.01em; }
  .converter__steps { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-4); font-family: var(--font-ui); font-size: 0.8125rem; font-weight: 600; color: var(--fg-muted); }
  .converter__steps li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .converter__steps span {
    width: 20px; height: 20px; border-radius: 50%;
    display: inline-grid; place-items: center;
    background: var(--accent-soft); color: var(--saffron-700);
    font-size: 0.75rem; font-weight: 800;
  }
  :global(html[data-theme='dark']) .converter__steps span { color: var(--saffron-400); }
  /* The shell is already a card; flatten it inside ours. */
  .converter :global(.tool-shell) { border: 0; border-radius: 0; background: transparent; }
  @media (max-width: 600px) {
    .converter__head { padding: var(--space-4); }
    .converter__steps { gap: var(--space-3); }
  }
  .hero__works { margin: var(--space-4) 0 0; text-align: center; font-family: var(--font-ui); font-size: 0.8125rem; color: var(--fg-muted); }

  /* Section heads */
  .section-head {
    max-width: 760px;
    margin: 0 auto var(--space-9);
    text-align: center;
  }
  .section-head--row {
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    text-align: left;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }
  .section-head__lede {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--fg-muted);
    margin-top: var(--space-4);
    line-height: 1.55;
  }
  .section--soft { background: var(--bg-soft); }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 800px) { .steps { grid-template-columns: 1fr; } }
  .step {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-7);
    position: relative;
    transition: border-color 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .step:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .step__num {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 0.8125rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: var(--space-4);
    letter-spacing: 0.06em;
  }
  .step h3 { margin-bottom: var(--space-3); font-size: 1.5rem; }
  .step p {
    color: var(--fg-muted);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  /* Privacy */
  .privacy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-9);
    align-items: center;
  }
  @media (max-width: 900px) { .privacy { grid-template-columns: 1fr; gap: var(--space-7); } }

  .privacy__lede {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--fg-muted);
    margin-block: var(--space-5) var(--space-6);
  }
  .privacy__list {
    list-style: none;
