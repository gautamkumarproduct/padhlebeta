---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FeatureCard from '~/components/FeatureCard.astro';
import FAQ from '~/components/FAQ.astro';
import InkSavingsCalculator from '~/components/InkSavingsCalculator.astro';
import ToolIcon from '~/components/ToolIcon.astro';
import PrivacyDiagram from '~/components/PrivacyDiagram.astro';
import { site, tools, type Tool } from '~/data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const homeFaq = [
  {
    q: 'Is Padhle Beta really free?',
    a: 'Yes — completely free, no signup, no watermarks, no hidden limits. We will never charge for the core tools. (We may add an optional tip jar in future to keep the project alive.)',
  },
  {
    q: 'Do my files get uploaded to a server?',
    a: 'Never. Every tool runs in your browser using pdf-lib. Your PDFs are processed locally on your device. Open DevTools and watch the Network tab — you will see zero uploads.',
  },
  {
    q: 'Will this work on my phone?',
    a: 'Yes. The site is mobile-first and the tools work on modern mobile browsers including Chrome on Android and Safari on iOS.',
  },
  {
    q: 'Do I need to install anything?',
    a: 'No installation, no extension. Open the tool page, drop your file, download the result. That is it.',
  },
  {
    q: 'What file formats are supported?',
    a: 'PDF in, PDF out for most tools. The image-to-PDF tool accepts JPG, PNG, and HEIC (iPhone) and outputs PDF.',
  },
  {
    q: 'How is this different from other PDF tools?',
    a: 'Three things: (1) it is built specifically for Indian students printing coaching notes, (2) every tool is genuinely free with no signup walls, and (3) there is no file upload — your notes stay on your device.',
  },
];

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.siteUrl + site.basePath,
  logo: site.siteUrl + site.basePath + '/favicon.svg',
  sameAs: [`https://github.com/${site.github.org}/${site.github.repo}`],
};

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: site.name,
  url: site.siteUrl + site.basePath,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (browser-based)',
  description: site.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: tools.map((t) => t.name),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.siteUrl + site.basePath + '/' },
  ],
};
---

<BaseLayout
  title={site.name}
  description={site.description}
  jsonLd={[orgJsonLd, webAppJsonLd, breadcrumb]}
>
  {/* HERO */}
  <section class="hero">
    <div class="atmos-blob atmos-blob--1" aria-hidden="true"></div>
    <div class="atmos-blob atmos-blob--2" aria-hidden="true"></div>

    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow fade-up">Free forever · No signup · 100% in-browser</span>
        <h1 class="fade-up fade-up--1">
          Print coaching notes<br />
          <span class="hero__highlight">without burning ink.</span>
        </h1>
        <p class="hero__lede fade-up fade-up--2">
          Convert dark lecture slides to ink-saving printables, merge chapters,
          compress big files, and more — entirely in your browser.
          Files never leave your device.
        </p>
        <div class="hero__ctas fade-up fade-up--3">
          <a href={site.basePath + '/tools/dark-to-light/'} class="btn btn--primary btn--lg">
            Convert dark PDF →
          </a>
          <a href={site.basePath + '/tools/'} class="btn btn--ghost btn--lg">
            Browse all tools
          </a>
        </div>
        <div class="hero__stats fade-up fade-up--4">
          <div>
            <span class="hero__stat-num" data-count="5">5</span>
            <span class="hero__stat-label">PDF tools</span>
          </div>
          <div>
            <span class="hero__stat-num" data-count="~60">~60%</span>
            <span class="hero__stat-label">Ink savings, on average</span>
          </div>
          <div>
            <span class="hero__stat-num" data-count="0">0</span>
            <span class="hero__stat-label">Files uploaded. Ever.</span>
          </div>
        </div>
      </div>

      <div class="hero__visual fade-up fade-up--2" aria-hidden="true">
        <div class="hero__demo">
          <div class="hero__demo-tab">
            <span></span><span></span><span></span>
            <span class="hero__demo-tab-label">padhlebeta.in</span>
          </div>
          <div class="hero__demo-body">
            <div class="hero__demo-before">
              <div class="hero__demo-slide">
                <div class="hero__demo-slide-bar"></div>
                <div class="hero__demo-slide-line" style="width: 70%"></div>
                <div class="hero__demo-slide-line" style="width: 85%"></div>
                <div class="hero__demo-slide-line" style="width: 60%"></div>
                <div class="hero__demo-slide-line" style="width: 75%"></div>
              </div>
              <span class="hero__demo-tag">Dark slide</span>
            </div>
            <div class="hero__demo-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <div class="hero__demo-after">
              <div class="hero__demo-slide hero__demo-slide--light">
                <div class="hero__demo-slide-bar"></div>
                <div class="hero__demo-slide-line" style="width: 70%"></div>
                <div class="hero__demo-slide-line" style="width: 85%"></div>
                <div class="hero__demo-slide-line" style="width: 60%"></div>
                <div class="hero__demo-slide-line" style="width: 75%"></div>
              </div>
              <span class="hero__demo-tag hero__demo-tag--accent">Light, printable</span>
            </div>
          </div>
          <div class="hero__demo-footer">
            <span class="hero__demo-save">
              <span class="hero__demo-save-dot"></span>
              Saved ~₹720 in ink this year
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* TOOL CARDS */}
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">All tools</span>
        <h2>Everything you need<br/>to handle coaching PDFs.</h2>
        <p class="section-head__lede">
          Five focused tools. Each one is a one-shot fix for a real student problem.
          Pick what you need, get the file back in seconds.
        </p>
      </header>
      <div class="grid grid--3">
        {tools.map((t: Tool, i: number) => (
          <div class={`reveal reveal--${(i % 5) + 1}`}>
            <FeatureCard
              href={`${site.basePath}/tools/${t.slug}/`}
              title={t.name}
              description={t.description}
              iconType={t.slug}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* HOW IT WORKS */}
  <section class="section section--soft">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>Three steps.<br/>Zero friction.</h2>
      </header>
      <ol class="steps reveal" role="list">
        <li class="step">
          <span class="step__num">01</span>
          <h3>Pick a tool</h3>
          <p>Choose from the five free tools above. Each one solves a single, specific problem with coaching notes.</p>
        </li>
        <li class="step">
          <span class="step__num">02</span>
          <h3>Drop your file</h3>
          <p>Drag your PDF or images into the browser. They never leave your device — processing happens locally.</p>
        </li>
        <li class="step">
          <span class="step__num">03</span>
          <h3>Download the result</h3>
          <p>Click download. The converted, merged, or compressed file is on your machine in seconds. Print or share.</p>
        </li>
      </ol>
    </div>
  </section>

  {/* PRIVACY PROMISE */}
  <section class="section privacy-section">
    <div class="container privacy">
      <div class="reveal">
        <span class="eyebrow">Privacy first</span>
        <h2>Your notes never leave your browser.</h2>
        <p class="privacy__lede">
          Padhle Beta is built around a single privacy promise: every PDF you process stays on your device.
          Open your browser's DevTools, switch to the Network tab, and run any tool. You will see zero uploads.
        </p>
        <ul role="list" class="privacy__list">
          <li><strong>No accounts.</strong> No email, no Google sign-in, no phone number.</li>
          <li><strong>No analytics on your files.</strong> We never see what you upload — we cannot, by design.</li>
          <li><strong>No ads.</strong> No third-party trackers, no retargeting pixels, no nonsense.</li>
          <li><strong>Open source.</strong> Every line of code lives on GitHub. Audit it yourself.</li>
        </ul>
        <a href={`${site.basePath}/privacy/`} class="btn btn--ghost">Read the privacy policy →</a>
      </div>
      <div class="privacy__visual reveal">
        <PrivacyDiagram />
      </div>
    </div>
  </section>

  {/* INK SAVINGS CALCULATOR */}
  <InkSavingsCalculator />

  {/* WHY PADHLE BETA */}
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <span class="eyebrow">Why Padhle Beta</span>
        <h2>Built for Indian students,<br/>not generic PDF users.</h2>
      </header>

      <div class="comparison reveal">
        <div class="comparison__col">
          <h3>Other PDF tools</h3>
          <ul role="list">
            <li>Upload your file to a server</li>
            <li>Force a signup before download</li>
            <li>Stamp your file with a watermark</li>
            <li>Slow, ad-cluttered interface</li>
            <li>Made for office workers in 2014</li>
          </ul>
        </div>
        <div class="comparison__col comparison__col--us">
          <h3>Padhle Beta</h3>
          <ul role="list">
            <li>Everything runs in your browser. Zero uploads.</li>
            <li>No signup, ever. Open and use.</li>
            <li>No watermark, no branding, no nonsense</li>
            <li>Fast, mobile-first, clean UI</li>
            <li>Made for NEET/JEE students printing coaching notes</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* BLOG TEASER */}
  <section class="section section--soft">
    <div class="container">
      <header class="section-head section-head--row reveal">
        <div>
          <span class="eyebrow">From the blog</span>
          <h2>Tips, guides, and study strategies.</h2>
        </div>
        <a href={`${site.basePath}/blog/`} class="btn btn--ghost">All posts →</a>
      </header>
      <div class="grid grid--3">
        {posts.map((post, i) => (
          <a class={`card blog-card reveal reveal--${i + 1}`} href={`${site.basePath}/blog/${post.id}/`}>
            <span class="tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="blog-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <span>· 5 min read</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* HOME FAQ */}
  <FAQ items={homeFaq} id="home-faq" />

  {/* NEWSLETTER + DONATE */}
  <section class="section cta-section">
    <div class="atmos-blob atmos-blob--1" aria-hidden="true"></div>
    <div class="atmos-blob atmos-blob--2" aria-hidden="true"></div>
    <div class="container cta">
      <div class="reveal">
        <h2>Like the tools?<br/>Help us keep them free.</h2>
        <p>
          Padhle Beta is built and hosted on a student budget. If these tools saved you ink or money,
          consider chipping in for server time or just sharing the site with a friend.
        </p>
      </div>
      <div class="cta__actions reveal">
        <a href={`${site.basePath}/contact/`} class="btn btn--primary btn--lg">Share feedback</a>
        <a href={`https://github.com/${site.github.org}/${site.github.repo}`} class="btn btn--ghost btn--lg" rel="noopener">★ Star on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Scroll-triggered reveal — uses IntersectionObserver, runs once.
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    reveals.forEach((el) => io.observe(el));
  } else {
    // Fallback for ancient browsers
    reveals.forEach((el) => el.classList.add('is-visible'));
  }

  // Animated stat counters
  const animate = (el: HTMLElement, target: number, suffix = '') => {
    const start = performance.now();
    const duration = 1200;
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.round(target * eased) + suffix;
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const nums = document.querySelectorAll<HTMLElement>('.hero__stat-num');
  const numIo = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        const el = e.target as HTMLElement;
        const raw = el.dataset.count ?? el.textContent ?? '0';
        const match = raw.match(/^([^0-9]*)(\d+)(.*)$/);
        if (match) {
          const [, prefix, n, suffix] = match;
          const target = parseInt(n, 10);
          animate(el, target, prefix + suffix);
        }
        numIo.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  nums.forEach((n) => numIo.observe(n));
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(5rem, 10vw, 9rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    position: relative;
  }
  @media (max-width: 960px) { .hero__grid { grid-template-columns: 1fr; } }

  .hero__highlight {
    background: linear-gradient(135deg, var(--saffron-500) 0%, var(--saffron-700) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }

  .hero__lede {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--fg-muted);
    max-width: 560px;
    margin-block: var(--space-6) var(--space-7);
  }

  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .hero__stat-num {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 2.25rem;
    color: var(--fg);
    display: block;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .hero__stat-label {
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin-top: 6px;
    display: block;
  }

  /* Hero visual — browser-tab demo */
  .hero__visual { display: flex; justify-content: center; }
  .hero__demo {
    width: 100%;
    max-width: 480px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    position: relative;
  }
  .hero__demo-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 14px 18px;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }
  .hero__demo-tab span:nth-child(-n+3) {
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--ink-300);
  }
  .hero__demo-tab-label {
    margin-left: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .hero__demo-body {
    padding: var(--space-6);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
  }
  .hero__demo-before, .hero__demo-after {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hero__demo-arrow {
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__demo-slide {
    background: #0F172A;
    border-radius: var(--radius);
    padding: var(--space-4);
    aspect-ratio: 3/4;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hero__demo-slide--light {
    background: #FFFCF7;
    border: 1px solid var(--ink-200);
  }
  .hero__demo-slide-bar {
    height: 6px;
    width: 30%;
    background: var(--accent-soft);
    border-radius: 999px;
    margin-bottom: 6px;
  }
  .hero__demo-slide--light .hero__demo-slide-bar { background: rgba(255, 107, 26, 0.18); }
  .hero__demo-slide-line {
    height: 4px;
    background: rgba(250, 247, 242, 0.18);
    border-radius: 999px;
  }
  .hero__demo-slide--light .hero__demo-slide-line {
    background: var(--ink-200);
  }
  .hero__demo-tag {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-align: center;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero__demo-tag--accent { color: var(--saffron-700); }

  .hero__demo-footer {
    padding: var(--space-4) var(--space-5);
    background: var(--accent-soft);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .hero__demo-save {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--saffron-700);
  }
  .hero__demo-save-dot {
    width: 8px; height: 8px;
    background: var(--green-600);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.2);
  }

  /* Section heads */
  .section-head {
    max-width: 760px;
    margin: 0 auto var(--space-9);
    text-align: center;
  }
  .section-head--row {
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    text-align: left;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }
  .section-head__lede {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--fg-muted);
    margin-top: var(--space-4);
    line-height: 1.55;
  }
  .section--soft { background: var(--bg-soft); }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 800px) { .steps { grid-template-columns: 1fr; } }
  .step {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-7);
    position: relative;
    transition: border-color 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .step:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .step__num {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 0.8125rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: var(--space-4);
    letter-spacing: 0.06em;
  }
  .step h3 { margin-bottom: var(--space-3); font-size: 1.5rem; }
  .step p {
    color: var(--fg-muted);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  /* Privacy */
  .privacy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-9);
    align-items: center;
  }
  @media (max-width: 900px) { .privacy { grid-template-columns: 1fr; gap: var(--space-7); } }

  .privacy__lede {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--fg-muted);
    margin-block: var(--space-5) var(--space-6);
  }
  .privacy__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  .privacy__list li {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--fg);
    padding-left: 2rem;
    position: relative;
    line-height: 1.55;
  }
  .privacy__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4em;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--green-600);
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20 6L9 17l-5-5'/%3E%3C/svg%3E");
    background-size: 11px;
    background-position: center;
    background-repeat: no-repeat;
  }
  .privacy__list strong { color: var(--fg); font-weight: 600; }

  .privacy__visual {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    padding: var(--space-7) var(--space-5);
    box-shadow: var(--shadow);
  }

  /* Comparison */
  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  @media (max-width: 720px) { .comparison { grid-template-columns: 1fr; } }
  .comparison__col {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-7);
  }
  .comparison__col--us {
