---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { site } from '~/data/site';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props as Props;
const { Content } = await post.render();
// Estimate reading time from raw body
const wordsPerMinute = 220;
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / wordsPerMinute));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: site.siteUrl + site.basePath + '/favicon.svg' } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': site.siteUrl + site.basePath + '/blog/' + post.id + '/' },
  keywords: post.data.tags.join(', '),
  articleSection: post.data.category,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.siteUrl + site.basePath + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: site.siteUrl + site.basePath + '/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: site.siteUrl + site.basePath + '/blog/' + post.id + '/' },
  ],
};

// Related: same category, exclude current
const all = await getCollection('blog', ({ data }) => !data.draft);
const related = all
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
  <article class="section blog-post">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog/' },
        { label: post.data.title },
      ]} />

      <header class="post-header">
        <div class="post-header__meta">
          <span class="tag">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <span>· {readingTime} min read</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-header__desc">{post.data.description}</p>
      </header>

      <div class="post-progress" aria-hidden="true">
        <div class="post-progress__bar" data-post-progress></div>
      </div>

      <div class="prose post-body">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
      )}

      <div class="post-cta">
        <h3>Try the tools mentioned in this post</h3>
        <div class="post-cta__actions">
          <a href="/tools/dark-to-light/" class="btn btn--primary">Dark PDF → Light PDF</a>
          <a href="/tools/" class="btn btn--ghost">All tools</a>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--soft related-posts">
      <div class="container">
        <h2>Related posts</h2>
        <div class="grid grid--3">
          {related.map((p) => (
            <a class="card blog-card" href={`/blog/${p.id}/`}>
              <span class="tag">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Reading progress bar
  const bar = document.querySelector<HTMLElement>('[data-post-progress]');
  if (bar) {
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
    };
    document.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .post-header { max-width: var(--prose-max); margin: 0 auto var(--space-6); }
  .post-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin-bottom: var(--space-4);
  }
  .post-header__desc {
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--fg-muted);
    margin-top: var(--space-3);
  }

  .post-progress {
    position: sticky;
    top: 70px;
    height: 4px;
    background: var(--ink-100);
    border-radius: 999px;
    overflow: hidden;
    max-width: var(--prose-max);
    margin: 0 auto var(--space-6);
    z-index: 10;
  }
  .post-progress__bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--saffron-700));
    width: 0%;
    transition: width 100ms linear;
  }

  .post-body { max-width: var(--prose-max); margin: 0 auto; }

  .post-tags {
    max-width: var(--prose-max);
    margin: var(--space-7) auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .post-cta {
    max-width: var(--prose-max);
    margin: var(--space-8) auto 0;
    padding: var(--space-6);
    background: var(--accent-soft);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .post-cta h3 { margin-bottom: var(--space-4); }
  .post-cta__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }

  .related-posts h2 {
    max-width: var(--prose-max);
    margin: 0 auto var(--space-5);
  }
  .related-posts .blog-card { color: inherit; }
</style>
