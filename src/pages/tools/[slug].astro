---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import FAQ from '~/components/FAQ.astro';
import RelatedTools from '~/components/RelatedTools.astro';
import ToolShell from '~/components/ToolShell.astro';
import ToolIcon from '~/components/ToolIcon.astro';
import BeforeAfter from '~/components/BeforeAfter.astro';
import ConverterStudio from '~/components/ConverterStudio.astro';
import { site, tools } from '~/data/site';
import { platforms } from '~/data/platforms';
import { url, absUrl } from '~/lib/url';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return tools.map((t) => ({
    params: { slug: t.slug },
    props: { tool: t },
  }));
};

const { tool } = Astro.props;
const pageUrl = absUrl(`/tools/${tool.slug}/`);

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to use ${tool.name}`,
  description: tool.description,
  totalTime: 'PT1M',
  tool: { '@type': 'HowToTool', name: `${site.name} ${tool.name}` },
  step: tool.steps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: text,
    text,
    url: `${pageUrl}#tool`,
  })),
};

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${tool.name} – ${site.name}`,
  description: tool.metaDescription,
  applicationCategory: 'UtilitiesApplication',
  applicationSubCategory: 'PDF tool',
  operatingSystem: 'Any (web browser)',
  browserRequirements: 'Requires JavaScript. Works in Chrome, Safari, Firefox and Edge.',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: tool.benefits.join(', '),
  keywords: tool.keywords.join(', '),
  url: pageUrl,
  image: absUrl(`/og/${tool.slug}.png`),
};

const guides = tool.category === 'print' ? platforms.slice(0, 8) : [];
---

<BaseLayout
  title={tool.seoTitle}
  rawTitle
  description={tool.metaDescription}
  ogImage={`/og/${tool.slug}.png`}
  jsonLd={[howToJsonLd, softwareJsonLd]}
>
  <section class="section tool-hero page-hero">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: tool.name },
      ]} />

      <div class="tool-hero__inner">
        <div class="tool-hero__copy">
          <span class="tool-hero__icon" aria-hidden="true">
            <ToolIcon name={tool.slug as any} size={28} />
          </span>
          <span class="eyebrow">Free · No signup · No upload</span>
          <h1>{tool.name}</h1>
          <p class="tool-hero__lede">{tool.longDescription}</p>
        </div>

        <div id="tool" class="tool-card">
          {tool.slug === 'dark-to-light' ? <ConverterStudio dropTitle="Drop your dark PDF here" /> : <ToolShell tool={tool} />}
        </div>
      </div>
    </div>
  </section>

  {tool.slug === 'dark-to-light' && (
  <section class="section ba-section">
      <div class="container">
        <header class="center-head">
          <span class="eyebrow">See the difference</span>
          <h2>Black board notes → clean white pages</h2>
          <p>Drag the slider — this is exactly what happens to your pages.</p>
        </header>
        <BeforeAfter />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="tool-page-grid">
        <div>
          <span class="eyebrow">How it works</span>
          <h2>Three steps. No uploads. No waiting.</h2>
          <ol class="steps" role="list">
            {tool.steps.map((s, i) => (
              <li class="step">
                <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
                <p>{s}</p>
              </li>
            ))}
          </ol>

          <div class="tool-benefits">
            <span class="eyebrow">Why use it</span>
            <h3>What you get</h3>
            <ul role="list">
              {tool.benefits.map((b) => (
                <li>
                  <span class="tool-benefits__check" aria-hidden="true">✓</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <aside class="tool-aside">
          <div class="tool-aside__card">
            <h3>Privacy guarantee</h3>
            <p>This tool runs entirely in your browser. Your file is never uploaded, logged, or shared.</p>
            <a href={url('/privacy/')}>Read our privacy policy →</a>
          </div>
          <div class="tool-aside__card">
            <h3>No account needed</h3>
            <p>No email, no Google sign-in, no phone number. Open the tool, drop your file, done.</p>
          </div>
          <div class="tool-aside__card">
            <h3>Works offline</h3>
            <p>Once the page loads, your internet can drop. The tool will still finish the job.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <span class="eyebrow">Step-by-step guides</span>
        <h2>Printing notes from a specific platform?</h2>
        <ul class="guide-links" role="list">
          {guides.map((p) => (
            <li><a href={url(`/print/${p.slug}/`)}>How to print {p.name} notes →</a></li>
          ))}
          <li><a href={url('/print/')}>All platforms →</a></li>
        </ul>
      </div>
    </section>
  )}

  <FAQ items={tool.faq} id={`${tool.slug}-faq`} />

  <RelatedTools currentSlug={tool.slug} />
</BaseLayout>



<style>
  .guide-links {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-3);
  }
  .guide-links a {
    display: block;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--fg);
  }
  .guide-links a:hover { border-color: var(--accent); text-decoration: none; }

  .tool-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  .tool-hero__inner > * { min-width: 0; }
  @media (max-width: 900px) {
    .tool-hero__inner { grid-template-columns: 1fr; gap: var(--space-5); }
    .tool-hero__copy { display: contents; }
    .tool-hero__copy > * { order: 1; }
    #tool { order: 2; }
    .tool-hero__copy > .tool-hero__lede { order: 3; }
    .tool-hero__copy > .tool-hero__icon { display: none; }
  }

  .tool-hero__icon {
    display: inline-flex;
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: var(--accent-soft);
    color: var(--saffron-700);
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }
  .tool-hero__lede {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--fg-muted);
    margin-top: var(--space-4);
  }

  /* Steps */
  .steps { display: grid; gap: var(--space-4); padding: 0; margin: var(--space-5) 0 0; list-style: none; }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .step__num {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--accent);
    min-width: 36px;
  }
  .step p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--fg);
    margin: 0;
  }

  /* Benefits */
  .tool-benefits {
    margin-top: var(--space-8);
    background: var(--bg-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .tool-benefits h3 { margin-block: var(--space-3) var(--space-4); }
  .tool-benefits ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .tool-benefits li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fg);
  }
  .tool-benefits__check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--green-600);
    color: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Aside */
  .tool-page-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  @media (max-width: 900px) { .tool-page-grid { grid-template-columns: 1fr; } }
  .tool-aside { display: grid; gap: var(--space-3); position: sticky; top: 100px; }
  .tool-aside__card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .tool-aside__card h3 { font-size: 1rem; margin-bottom: var(--space-2); }
  .tool-aside__card p { font-family: var(--font-body); font-size: 0.9375rem; line-height: 1.55; color: var(--fg-muted); }
  .tool-aside__card a {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--accent);
    display: inline-block;
    margin-top: var(--space-2);
  }
</style>
