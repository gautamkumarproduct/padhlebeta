---
import { url } from '~/lib/url';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { site } from '~/data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PrivacyPolicy',
  name: `${site.name} Privacy Policy`,
  url: site.siteUrl + site.basePath + '/privacy/',
};
---

<BaseLayout
  title="Privacy Policy"
  description="Padhle Beta never uploads your files. This page explains exactly what data we collect (almost none), why, and how to contact us about it."
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />

      <div class="prose">
        <span class="eyebrow">Last updated: 26 September 2026</span>
        <h1>Privacy Policy</h1>

        <p>
          <strong>The short version:</strong> Padhle Beta does not collect, store, or transmit the files you process. Every PDF and image you touch in our tools stays on your device. We do not have a database of your files because we have never seen them.
        </p>

        <h2>What data we do not collect</h2>

        <ul>
          <li>The contents of any PDF or image you upload.</li>
          <li>The names of your files.</li>
          <li>Any metadata embedded in your files.</li>
          <li>Your IP address in connection with specific tools (see analytics below for aggregate counts only).</li>
        </ul>

        <h2>How our tools work</h2>

        <p>
          All PDF processing happens client-side. When you use the dark-to-light tool, the merge tool, the compress tool, the image-to-PDF tool, or the extract-pages tool:
        </p>

        <ol>
          <li>Your browser downloads the tool's JavaScript bundle once.</li>
          <li>Your browser loads your file from your device into memory.</li>
          <li>Your browser processes the file locally using pdf-lib and PDF.js.</li>
          <li>Your browser saves the result back to your device.</li>
        </ol>

        <p>
          At no point does the file leave your device. You can verify this yourself: open your browser's developer tools, switch to the Network tab, and run any tool. You will see zero outbound network requests carrying your file.
        </p>

        <h2>Analytics</h2>

        <p>
          We use privacy-respecting, aggregate-only analytics to understand which tools are used and where the site is slow. Specifically:
        </p>

        <ul>
          <li>We log anonymous page views (page path, country, device type) via a self-hosted analytics tool. No personal identifiers. No cross-site tracking. No advertising cookies.</li>
          <li>We do not use Google Analytics, Facebook Pixel, or any other third-party tracking.</li>
          <li>You can opt out by enabling "Do Not Track" in your browser. We honour that signal.</li>
        </ul>

        <h2>Cookies</h2>

        <p>
          We use one cookie: a small text value that remembers your dark/light theme preference. We do not use advertising cookies, tracking cookies, or third-party cookies of any kind.
        </p>

        <h2>Hosting</h2>

        <p>
          The site is hosted on GitHub Pages. GitHub's privacy practices apply to the hosting layer (i.e. GitHub sees your IP address when you load any page, like every site on the internet). Refer to
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" rel="noopener">GitHub's Privacy Statement</a>
          for details on their practices.
        </p>

        <h2>Children's privacy</h2>

        <p>
          Padhle Beta is intended for use by students of all ages. We do not knowingly collect personal information from anyone. Because we collect essentially no data at all, COPPA and equivalent regulations do not impose meaningful obligations on us.
        </p>

        <h2>Changes to this policy</h2>

        <p>
          If we make material changes to this policy, we will update the "Last updated" date at the top and post a note on the home page. The previous version will remain available at <code>/privacy/v1/</code> for at least 90 days.
        </p>

        <h2>Contact</h2>

        <p>
          Questions, complaints, or requests? Reach us at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> or via the <a href={url('/contact/')}>contact form</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
