---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { site, nav } from '~/data/site';
import { url, absUrl } from '~/lib/url';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  canonical?: string;
  noindex?: boolean;
  bodyClass?: string;
  /** Use `title` verbatim (no " · Padhle Beta" suffix) — for keyword-led SERP titles. */
  rawTitle?: boolean;
  ogType?: 'website' | 'article';
  lang?: string;
}

const {
  title,
  description = site.description,
  ogImage = site.ogImage,
  jsonLd,
  canonical,
  noindex = false,
  bodyClass = '',
  rawTitle = false,
  ogType = 'website',
  lang = site.locale,
} = Astro.props;

// Skip the brand suffix when it would push the title past ~60 chars (Google truncates).
const suffixed = `${title} | ${site.name}`;
const fullTitle = rawTitle || title === site.name || suffixed.length > 62 ? title : suffixed;
// Normalise to a trailing slash so every URL has exactly one canonical form.
const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonicalUrl = canonical ?? absUrl(path);
const ogImageUrl = absUrl(ogImage);
const jsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: ['PadhleBeta', 'Padhle Beta PDF Tools'],
  url: absUrl('/'),
  inLanguage: 'en-IN',
  publisher: { '@type': 'Organization', name: site.name, logo: absUrl('/icons/icon-512.png') },
};

const gscToken = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingToken = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const fonts = 'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0F172A" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    {bingToken && <meta name="msvalidate.01" content={bingToken} />}

    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/icons/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Blog`} href={url('/rss.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_IN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {[websiteJsonLd, ...jsonLdArray].map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fonts} /></noscript>
  </head>

  <body class={bodyClass}>
    <a href="#main" class="sr-only">Skip to main content</a>
    <Header nav={nav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
