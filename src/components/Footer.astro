---
import { site, tools } from '~/data/site';
import { platforms } from '~/data/platforms';
import { intents } from '~/data/intents';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <div class="site-footer__mark">
        <svg viewBox="0 0 36 36" width="28" height="28" aria-hidden="true" fill="none">
          <rect width="36" height="36" rx="10" fill="#FAF7F2" />
          <path d="M11 9 L11 27 L14 27 L14 20 L19 20 Q24 20 24 14.5 Q24 9 19 9 Z M14 12 L19 12 Q21 12 21 14.5 Q21 17 19 17 L14 17 Z" fill="#0F172A" />
          <circle cx="27" cy="11" r="2.5" fill="#FF6B1A" />
        </svg>
        <strong>padhlebeta</strong>
      </div>
      <p>Convert black coaching notes to white, A4 printable PDFs — plus free PDF tools for Indian students.</p>
      <p class="site-footer__small">Files never leave your device. 100% browser-based. No accounts.</p>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Tools</h2>
      <ul role="list">
        {tools.map((t) => (
          <li><a href={`${site.basePath}/tools/${t.slug}/`}>{t.shortName}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Print guides</h2>
      <ul role="list">
        {platforms.slice(0, 8).map((p) => (
          <li><a href={`${site.basePath}/print/${p.slug}/`}>{p.slug.endsWith('-notes') ? `${p.name} notes` : p.name}</a></li>
        ))}
        {intents.slice(0, 4).map((i) => (
          <li><a href={`${site.basePath}/${i.slug}/`}>{i.linkText}</a></li>
        ))}
        <li><a href={`${site.basePath}/print/`}>All guides →</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Resources</h2>
      <ul role="list">
        <li><a href={`${site.basePath}/focus-timer/`}>Focus timer</a></li>
        <li><a href={`${site.basePath}/blog/`}>Blog</a></li>
        <li><a href={`${site.basePath}/about/`}>About</a></li>
        <li><a href={`${site.basePath}/contact/`}>Contact</a></li>
        <li><a href={`${site.basePath}/rss.xml`}>RSS</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Legal</h2>
      <ul role="list">
        <li><a href={`${site.basePath}/privacy/`}>Privacy</a></li>
        <li><a href={`${site.basePath}/terms/`}>Terms</a></li>
        <li><a href={`https://github.com/${site.github.org}/${site.github.repo}`} rel="noopener">Source on GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <span>© {year} {site.name}. Made for students, by students.</span>
    <span>Not affiliated with any coaching platform · Open source</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    background: var(--ink-950);
    color: var(--paper-100);
    padding-block: var(--space-10) var(--space-6);
    position: relative;
    overflow: hidden;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.4;
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  @media (max-width: 800px) {
    .site-footer__inner { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }

  .site-footer__mark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.0625rem;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }
  .site-footer__brand p { color: var(--ink-300); font-size: 0.9375rem; line-height: 1.6; max-width: 320px; margin-bottom: var(--space-2); }
  .site-footer__small { color: var(--ink-400) !important; font-size: 0.8125rem !important; }

  .site-footer__mark strong { color: #FAF7F2; }
  .site-footer__col .site-footer__heading {
    font-family: var(--font-ui);
    line-height: 1.3;
    margin-top: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: var(--space-4);
  }
  .site-footer__col ul { display: flex; flex-direction: column; gap: 0.6rem; }
  .site-footer__col a {
    color: var(--ink-300);
    font-size: 0.9375rem;
    transition: color 160ms var(--ease-out);
  }
  .site-footer__col a:hover { color: var(--saffron-400); text-decoration: none; }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-7);
    margin-top: var(--space-9);
    border-top: 1px solid var(--ink-800);
    font-size: 0.8125rem;
    color: var(--ink-400);
  }
  @media (max-width: 520px) {
    .site-footer__bottom { flex-direction: column; gap: var(--space-2); align-items: flex-start; }
  }
</style>
