---
export interface Crumb { label: string; href?: string; }
export interface Props { items: Crumb[]; }
const { items } = Astro.props;

const base = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: base + item.href } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol role="list">
    {items.map((item) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</nav>

<style>
  .breadcrumbs {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--fg-subtle);
    margin-bottom: var(--space-5);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .breadcrumbs li { display: inline-flex; align-items: center; }
  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.4rem;
    color: var(--fg-subtle);
    opacity: 0.5;
  }
  .breadcrumbs a { color: var(--fg-muted); }
  .breadcrumbs a:hover { color: var(--fg); text-decoration: none; }
  .breadcrumbs span[aria-current='page'] { color: var(--fg); font-weight: 600; }
</style>
