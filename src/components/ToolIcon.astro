---
/**
 * Custom SVG icons for the PDF tools. Each one is hand-drawn with consistent
 * stroke weight (1.5px), 24x24 viewBox, and currentColor so they inherit colour
 * from their parent. Premium feel: minimal, geometric, monoline.
 */
export interface Props {
  /** Tool slug. Unknown slugs fall back to a generic document icon. */
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
---

{name === 'dark-to-light' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 3 A9 9 0 0 1 12 21 Z" fill="currentColor" stroke="none" />
    <circle cx="15.5" cy="8.5" r="1" fill="currentColor" stroke="none" />
    <path d="M12 3 L12 21" stroke="currentColor" stroke-opacity="0.3" stroke-dasharray="1 2" stroke="none" />
  </svg>
)}

{name === 'merge' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="3" width="8" height="8" rx="1.5" />
    <rect x="13" y="3" width="8" height="8" rx="1.5" />
    <path d="M7 11 L7 15 Q7 17 9 17 L15 17 Q17 17 17 15 L17 11" />
    <path d="M12 17 L12 21 M9 18 L12 21 L15 18" />
  </svg>
)}

{name === 'compress' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M4 9 L9 9 M4 9 L4 4 M4 9 L7 6" />
    <path d="M20 9 L15 9 M20 9 L20 4 M20 9 L17 6" />
    <path d="M4 15 L9 15 M4 15 L4 20 M4 15 L7 18" />
    <path d="M20 15 L15 15 M20 15 L20 20 M20 15 L17 18" />
    <rect x="8" y="8" width="8" height="8" rx="1.5" />
  </svg>
)}

{name === 'image-to-pdf' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <circle cx="8.5" cy="9.5" r="1.25" fill="currentColor" stroke="none" />
    <path d="M3 16 L8 11 L13 16" />
    <path d="M11 16 L16 12 L21 17" />
    <rect x="14" y="15" width="7" height="5" rx="1" fill="currentColor" fill-opacity="0.15" stroke="none" />
    <path d="M14 15 L21 20 M21 15 L14 20" stroke="currentColor" stroke-width="1" stroke-opacity="0.5" />
  </svg>
)}

{name === 'extract-pages' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="4" y="3" width="11" height="14" rx="1.5" />
    <path d="M8 7 L11 7 M8 10 L11 10 M8 13 L11 13" />
    <path d="M15 12 L20 12 M15 12 L15 8 M15 12 L20 17" stroke-width="1.75" />
  </svg>
)}

{name === 'pages-per-sheet' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="2" /><rect x="6" y="6" width="5" height="5" rx="0.75" /><rect x="13" y="6" width="5" height="5" rx="0.75" /><rect x="6" y="13" width="5" height="5" rx="0.75" /><rect x="13" y="13" width="5" height="5" rx="0.75" />
  </svg>
)}

{name === 'grayscale-pdf' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="4" y="3" width="16" height="18" rx="2" /><path d="M4 12 L20 12" /><rect x="4" y="12" width="16" height="9" rx="0" fill="currentColor" fill-opacity="0.35" stroke="none" /><path d="M8 7 L16 7" />
  </svg>
)}

{name === 'split-pdf' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="4" width="7" height="16" rx="1.5" /><rect x="14" y="4" width="7" height="16" rx="1.5" /><path d="M12 3 L12 21" stroke-dasharray="2 2" />
  </svg>
)}

{name === 'organize-pdf' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="3" width="7" height="8" rx="1.25" /><rect x="14" y="3" width="7" height="8" rx="1.25" /><rect x="3" y="13" width="7" height="8" rx="1.25" /><path d="M14 17 L21 17 M18 14 L21 17 L18 20" />
  </svg>
)}

{name === 'rotate-pdf' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="7" y="7" width="10" height="13" rx="1.5" /><path d="M4 9 A8 8 0 0 1 16 3.5" /><path d="M16 3.5 L13 3 M16 3.5 L15.5 6.5" />
  </svg>
)}

{name === 'crop-pdf' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <path d="M6 2 L6 18 L22 18" /><path d="M2 6 L18 6 L18 22" />
  </svg>
)}

{name === 'add-page-numbers' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8 L16 8 M8 11.5 L16 11.5" /><path d="M11 16 L12.5 15 L12.5 19" />
  </svg>
)}

{name === 'pdf-to-jpg' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="3" y="3" width="10" height="13" rx="1.5" /><rect x="11" y="10" width="10" height="11" rx="1.5" fill="currentColor" fill-opacity="0.12" /><circle cx="14.5" cy="13.5" r="1" fill="currentColor" stroke="none" /><path d="M11 19 L15 16 L21 20" />
  </svg>
)}

{name === 'focus-timer' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <circle cx="12" cy="13" r="8" /><path d="M12 9 L12 13 L15 15" /><path d="M9 2 L15 2" />
  </svg>
)}

{!['dark-to-light','merge','compress','image-to-pdf','extract-pages','pages-per-sheet','grayscale-pdf','split-pdf','organize-pdf','rotate-pdf','crop-pdf','add-page-numbers','pdf-to-jpg','focus-timer'].includes(name) && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
    <rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8 L15 8 M9 12 L15 12 M9 16 L13 16" />
  </svg>
)}
