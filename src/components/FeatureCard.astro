---
import ToolIcon from './ToolIcon.astro';

export interface Props {
  href: string;
  title: string;
  description: string;
  iconType?: 'dark-to-light' | 'merge' | 'compress' | 'image-to-pdf' | 'extract-pages';
}
const { href, title, description, iconType } = Astro.props;
---

<a class="card feature-card" href={href}>
  {iconType && (
    <span class="card__icon" aria-hidden="true">
      <ToolIcon name={iconType} size={22} />
    </span>
  )}
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="feature-card__arrow" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
  </span>
</a>

<style>
  .feature-card {
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .feature-card:hover { text-decoration: none; }
  .feature-card__arrow {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-5);
    color: var(--accent);
    transition: transform 280ms var(--ease-out);
    display: inline-flex;
  }
  .feature-card:hover .feature-card__arrow {
    transform: translateX(6px);
  }
</style>
